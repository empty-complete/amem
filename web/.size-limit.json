[
  {
    "name": "JS: входной кусок",
    "path": "python/amem_web/dist/assets/index-*.js",
    "limit": "220 kB",
    "gzip": true
  },
  {
    "name": "JS: приложение без ленивых кусков (pdf.js, KaTeX, CodeMirror, небо, 3D)",
    "path": [
      "python/amem_web/dist/assets/*.js",
      "!python/amem_web/dist/assets/PdfPage-*.js",
      "!python/amem_web/dist/assets/SourceView-*.js",
      "!python/amem_web/dist/assets/katex-*.js",
      "!python/amem_web/dist/assets/SkyCanvas-*.js",
      "!python/amem_web/dist/assets/Sky3D-*.js",
      "!python/amem_web/dist/assets/float-tooltip-*.js"
    ],
    "limit": "380 kB",
    "gzip": true
  },
  {
    "name": "Лениво: pdf.js (страница источника)",
    "path": "python/amem_web/dist/assets/PdfPage-*.js",
    "limit": "140 kB",
    "gzip": true
  },
  {
    "name": "Лениво: воркер pdf.js (отдельный поток)",
    "path": "python/amem_web/dist/assets/pdf.worker.min-*.mjs",
    "limit": "450 kB",
    "gzip": true
  },
  {
    "name": "Лениво: KaTeX (формулы)",
    "path": ["python/amem_web/dist/assets/katex-*.js", "python/amem_web/dist/assets/katex-*.css"],
    "limit": "90 kB",
    "gzip": true
  },
  {
    "name": "Лениво: CodeMirror (исходник записи)",
    "path": "python/amem_web/dist/assets/SourceView-*.js",
    "limit": "170 kB",
    "gzip": true
  },
  {
    "name": "Лениво: небо 2D (force-graph, d3)",
    "path": ["python/amem_web/dist/assets/SkyCanvas-*.js", "python/amem_web/dist/assets/float-tooltip-*.js"],
    "limit": "70 kB",
    "gzip": true
  },
  {
    "name": "Лениво: небо 3D (three.js; грузится только по переключателю «3D»)",
    "path": "python/amem_web/dist/assets/Sky3D-*.js",
    "limit": "360 kB",
    "gzip": true
  },
  {
    "name": "CSS приложения (все стили HeroUI; урезать в части G)",
    "path": ["python/amem_web/dist/assets/*.css", "!python/amem_web/dist/assets/katex-*.css"],
    "limit": "54 kB",
    "gzip": true
  }
