# Настройки docker compose для amemo: скопируйте в .env (он в .gitignore) и поправьте.
# Секретов в репозитории нет — пароль и токены живут только в .env и в томах.

# Пароль роли amemo в базе compose. Задаётся при первом создании тома amemo-pg; потом его меняют в базе
# (ALTER ROLE amemo PASSWORD '…') и здесь одновременно.
AMEMO_PG_PASSWORD=change-me

# Человек службы: кто пишет из браузера с cookie (person:имя).
AMEMO_AGENT=person:me

# Вход по токенам (общая служба). Пусто — служба без входа (--no-auth): порт наружу только на 127.0.0.1.
# Токен: docker compose exec amemo amemo token create person:me --file /var/lib/amemo/state/tokens
# (файл в томе состояния; токен показывается один раз), затем AMEMO_TOKENS=/var/lib/amemo/state/tokens
# и docker compose up -d amemo.
AMEMO_TOKENS=

# Порт службы на этой машине (только 127.0.0.1).
AMEMO_PUBLISH_PORT=8767

# Папка документов на этой машине (только чтение внутри контейнера). Пусто — пустой том amemo-docs.
AMEMO_DOCS_DIR=
