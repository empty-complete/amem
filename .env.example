# Настройки docker compose для amem: скопируйте в .env (он в .gitignore) и поправьте.
# Секретов в репозитории нет — пароль и токены живут только в .env и в томах.

# Пароль роли amem в базе compose. Задаётся при первом создании тома amem-pg; потом его меняют в базе
# (ALTER ROLE amem PASSWORD '…') и здесь одновременно.
AMEM_PG_PASSWORD=change-me

# Человек службы: кто пишет из браузера с cookie (person:имя).
AMEM_AGENT=person:me

# Вход по токенам (общая служба). Пусто — служба без входа (--no-auth): порт наружу только на 127.0.0.1.
# Токен: docker compose exec amem amem token create person:me --file /var/lib/amem/state/tokens
# (файл в томе состояния; токен показывается один раз), затем AMEM_TOKENS=/var/lib/amem/state/tokens
# и docker compose up -d amem.
AMEM_TOKENS=

# Порт службы на этой машине (только 127.0.0.1).
AMEM_PUBLISH_PORT=8767

# Папка документов на этой машине (только чтение внутри контейнера). Пусто — пустой том amem-docs.
AMEM_DOCS_DIR=
