#!/usr/bin/env bash
# Проверка на приватное перед push: добавленные строки сверяются со списком образцов, который лежит ВНЕ репозитория.
# Включение: git config core.hooksPath tools/hooks
# Список: $AMEMO_PRIVATE_PATTERNS или ~/.config/amemo/private-patterns.txt — по одному регулярному выражению
# (grep -E, без учёта регистра) на строку; строки с # — комментарии. Файла нет — предупреждение, push проходит.
set -u
patterns="${AMEMO_PRIVATE_PATTERNS:-$HOME/.config/amemo/private-patterns.txt}"
if [ ! -r "$patterns" ]; then
  echo "pre-push: нет списка приватных образцов ($patterns) — проверка пропущена" >&2
  exit 0
fi
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # удаление ветки
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base="$remote_sha"
  fi
  hits=$(git diff "$base" "$local_sha" -- . ':(exclude)tools/hooks/pre-push' \
         | grep -E '^\+' | grep -v -E '^\+\+\+' \
         | grep -i -E -f <(grep -v -E '^\s*(#|$)' "$patterns") || true)
  if [ -n "$hits" ]; then
    echo "pre-push: в $local_ref найдено приватное — push остановлен:" >&2
    echo "$hits" | head -20 >&2
    status=1
  fi
done
exit $status
