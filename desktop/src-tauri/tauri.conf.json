{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "amemo",
  "version": "0.0.0",
  "identifier": "io.github.empty-complete.amemo",
  "build": {
    "frontendDist": "../../web/dist-setup",
    "beforeBuildCommand": "npm run build:parts"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "amemo",
        "url": "setup.html",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "amemo",
    "homepage": "https://github.com/empty-complete/amemo",
    "license": "AGPL-3.0-only",
    "shortDescription": "Shared memory with sourced claims for people and AI agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": {
      "../launcher/target/release/amemo.exe": "bin/amemo.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyQTM0OUI2RDIwRTBGNDEKUldSQkR3N1N0a21qa2l1VFhQVi85aTNBbThjS0NFS1QveGMvc1dsckpSL1QxSE5BUnI5Qm54MUMK",
      "endpoints": [
        "https://github.com/empty-complete/amemo/releases/download/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
